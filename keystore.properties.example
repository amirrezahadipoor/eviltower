# Example signing configuration for برج شیطانی (Evil Tower).
# Copy to `keystore.properties` in the repository root and fill in real values.
# NEVER commit the real file or the .jks keystore (both are git-ignored).
#
# Generate a release keystore with:
#   keytool -genkeypair -v -keystore eviltower-release.jks -alias eviltower \
#           -keyalg RSA -keysize 2048 -validity 10000 \
#           -storepass CHANGE_ME -keypass CHANGE_ME \
#           -dname "CN=Evil Tower, OU=Games, O=Hadipoor, L=Tehran, S=Tehran, C=IR"

storeFile=eviltower-release.jks
storePassword=CHANGE_ME
keyAlias=eviltower
keyPassword=CHANGE_ME
